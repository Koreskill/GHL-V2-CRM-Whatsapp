# Supabase Postgres (connection pooler, puerto 6543)
DATABASE_URL=

# Supabase Auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (Supabase > Project Settings > API Keys > Secret keys, sb_secret_...).
# Solo server-side: crea usuarios y escribe app_metadata. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Zernio
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_PROFILE_ID=

# IA — OpenRouter (capa de acceso multi-modelo, API compatible con OpenAI)
OPENROUTER_API_KEY=
# Modelo de CLASIFICACIÓN del triaje. Usa la Decisions API (POST /api/alpha/decisions), que es un
# endpoint aparte del de chat: no sirve cualquier modelo, tiene que ser uno de System One.
OPENROUTER_DECISION_MODEL=typesafe/jev-1.13

# Slug proveedor/modelo por defecto del agente (ej. openai/gpt-4.1-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Catálogo de propiedades desde Google Sheets.
# Con cuenta de servicio funciona con hojas PRIVADAS (compartirlas con su client_email como lector).
# Sin ella se usa el export CSV, que exige la hoja como "cualquiera con el enlace": ojo con las
# observaciones internas, quedan accesibles para quien tenga la URL.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Barridos de recuperación (Scheduler de Dokploy)
CRON_SECRET=

# NO definir APP_BASE_URL: el host se toma del request.

# Calendario: link de tu agenda de Cal.com (https://cal.com/usuario)
CALCOM_URL=
CALCOM_API_KEY=

# Topes de respuestas del agente por hora: por inmobiliaria y global (todas juntas). Protegen el saldo.
AGENT_MAX_REPLIES_PER_HOUR=300
AGENT_MAX_REPLIES_PER_HOUR_GLOBAL=3000

# Cola persistente (triaje, campañas, importaciones) y seguimientos. El worker corre dentro del servidor;
# con "off" no arranca (réplica solo HTTP) y el trabajo lo toma GET /api/cron/jobs desde el Scheduler.
JOBS_WORKER=

# Campañas: el envío real exige "true" (sin esto se puede estimar y confirmar, pero no enviar).
CAMPAIGNS_SEND_ENABLED=

# Aviso externo de incidentes nuevos o reabiertos (POST JSON con `text` y `content`): Slack, Discord o
# Telegram (https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>). Solo https.
INCIDENT_ALERT_WEBHOOK_URL=
