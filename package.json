{
  "name": "setter-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:counts": "tsx scripts/db-counts.ts",
    "zernio:openapi": "node scripts/zernio-openapi.mjs && openapi-typescript openapi/zernio.slim.json -o src/lib/zernio/openapi.d.ts",
    "zernio:check": "tsx scripts/zernio-check.ts",
    "test": "tsx scripts/test-signature.ts && tsx scripts/test-units.ts && tsx scripts/test-catalog.ts && tsx scripts/test-deals.ts && tsx scripts/test-visits.ts && tsx scripts/test-sync.ts",
    "zernio:webhook": "tsx scripts/zernio-webhook.ts",
    "test:e2e": "tsx scripts/test-webhook-e2e.ts",
    "test:network": "tsx scripts/test-network-flow.ts",
    "zernio:sync": "tsx scripts/zernio-sync.ts",
    "zernio:import": "tsx scripts/zernio-import.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yaml": "^2.9.1"
  }
}
